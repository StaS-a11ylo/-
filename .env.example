# Скопируйте в .env и заполните своими значениями.

# Токен бота из @BotFather (обязательно)
BOT_TOKEN=

# Ключ LLM-провайдера (обязательно). Для локальной Ollama подойдёт любой непустой текст.
API_KEY=

# Адрес OpenAI-совместимого API.
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Groq: https://api.groq.com/openai/v1
# Ollama (локально): http://127.0.0.1:11434/v1
BASE_URL=https://api.openai.com/v1

# Название модели у провайдера
MODEL=gpt-4o-mini

# Свой (локальный) Bot API server, например http://127.0.0.1:8081.
# Оставьте пустым, чтобы работать с обычным api.telegram.org.
# TELEGRAM_API_BASE=

# Системный промпт — характер и правила бота
# SYSTEM_PROMPT=Ты — дружелюбный ассистент в Telegram. Отвечай кратко и по делу.

# Параметры генерации
TEMPERATURE=0.7
MAX_TOKENS=1024
REQUEST_TIMEOUT=60
MAX_RETRIES=2

# Память диалога: сколько последних сообщений помнить в каждом чате
HISTORY_LIMIT=20
# Сколько диалогов одновременно хранить в памяти
MAX_CHATS=1000
# Сколько запросов к LLM выполнять параллельно
MAX_CONCURRENCY=4

# Печатать ответ по мере генерации (true/false)
STREAM=true

# Telegram ID администраторов через запятую — им доступна команда /stats
ADMIN_IDS=

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
